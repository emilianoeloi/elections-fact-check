# Backend FactCheck Live (server/). NUNCA commite o .env real.
# Chave do OpenRouter (https://openrouter.ai/keys). Fica somente no backend.
OPENROUTER_API_KEY=
# Modelo usado para transcrição, assuntos, afirmações e checagem.
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Raciocínio: "auto" pede esforço mínimo (minimal/low) por tarefa para gastar menos tokens; "off" nunca envia o parâmetro.
OPENROUTER_REASONING=auto
# Resultados de busca injetados no prompt de cada checagem (padrão do OpenRouter: 5). Menos = menos tokens.
OPENROUTER_WEB_MAX_RESULTS=3
# Motor da busca web do OpenRouter: native, exa, firecrawl, parallel, perplexity. Vazio = padrão
# (nativo para modelos Google; o OpenRouter não documenta se isso equivale ao Grounding do Google Search).
OPENROUTER_WEB_ENGINE=
# Porta/host. Mantenha 127.0.0.1 para não expor o backend na rede.
HOST=127.0.0.1
PORT=8787
# Token opcional exigido no cabeçalho Authorization: Bearer <token>. Configure o mesmo valor no painel.
BACKEND_TOKEN=
# Timeout por chamada ao modelo (ms)
REQUEST_TIMEOUT_MS=60000
# Cache de checagens (segundos)
CHECK_CACHE_TTL_S=21600
